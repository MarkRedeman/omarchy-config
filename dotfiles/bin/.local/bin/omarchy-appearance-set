#!/usr/bin/env bash
# omarchy:summary=Set an appearance value (gap size or corner rounding)
# omarchy:args=gap <0-128> | rounding <0-128>
# omarchy:examples=omarchy-appearance-set gap 8 | omarchy-appearance-set rounding 16
#
# Writes ~/.local/state/omarchy/appearance.json and applies the change live.
# The same state is read by looknfeel.lua on every config load, so settings
# survive reloads and relogins. The panel's sliders step through powers of
# two (0 1 2 4 8 16 32 64 128); any integer in range is accepted.

set -euo pipefail

STATE_DIR="$HOME/.local/state/omarchy"
STATE="$STATE_DIR/appearance.json"
mkdir -p "$STATE_DIR"

if [[ ! -f $STATE ]]; then
  echo '{ "gap": 0, "rounding": 0 }' >"$STATE"
fi

# Update the state file IN PLACE (truncate + write). Replacing the file via
# mv would swap the inode out from under the mark.appearance panel's
# FileView watcher and silently break its live refresh.
write_state() {
  local tmp
  tmp=$(mktemp)
  jq "$@" "$STATE" >"$tmp"
  cat "$tmp" >"$STATE"
  rm -f "$tmp"
}

usage() {
  echo "Usage: ${0##*/} gap <0-128> | rounding <0-128>" >&2
  exit 2
}

[[ $# -eq 2 ]] || usage
key=$1
value=$2

case $key in
gap)
  [[ $value =~ ^[0-9]+$ ]] || usage
  (( value <= 128 )) || value=128
  write_state --argjson v "$value" '.gap = $v'

  outer=$((value * 2))
  border=0
  (( value > 0 )) && border=2
  # hyprctl keyword is unavailable under the Lua config; hl.config via the
  # eval path is the sanctioned live-apply route.
  hyprctl eval "hl.config({ general = { gaps_in = $value, gaps_out = $outer, border_size = $border } })" >/dev/null

  rounding=$(jq -r '.rounding // 0' "$STATE")
  hyprctl eval "hl.config({ decoration = { rounding = $rounding } })" >/dev/null
  notify-send "Appearance" "Gaps: ${value}px (outer ${outer}px)" -t 1500
  ;;

rounding)
  [[ $value =~ ^[0-9]+$ ]] || usage
  (( value <= 128 )) || value=128
  write_state --argjson v "$value" '.rounding = $v'
  hyprctl eval "hl.config({ decoration = { rounding = $value } })" >/dev/null
  notify-send "Appearance" "Corner radius: ${value}px" -t 1500
  ;;

*)
  usage
  ;;
esac
