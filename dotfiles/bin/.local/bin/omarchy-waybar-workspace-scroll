#!/usr/bin/env bash
set -euo pipefail

direction=${1:-}
if [[ "$direction" != "next" && "$direction" != "prev" ]]; then
    echo "Usage: ${0##*/} next|prev" >&2
    exit 2
fi

cursor_json=$(hyprctl cursorpos -j)
monitors_json=$(hyprctl monitors -j)
workspaces_json=$(hyprctl workspaces -j)

cursor_x=$(jq -r '.x' <<<"$cursor_json")
cursor_y=$(jq -r '.y' <<<"$cursor_json")

monitor_name=$(jq -r --argjson x "$cursor_x" --argjson y "$cursor_y" '
    map(select(
        ($x >= .x) and ($x < (.x + .width)) and
        ($y >= .y) and ($y < (.y + .height))
    )) | .[0].name // empty
' <<<"$monitors_json")

if [[ -z "$monitor_name" ]]; then
    monitor_name=$(jq -r '.[] | select(.focused) | .name' <<<"$monitors_json")
fi

active_id=$(jq -r --arg monitor "$monitor_name" '.[] | select(.name == $monitor) | .activeWorkspace.id' <<<"$monitors_json")
mapfile -t workspace_ids < <(jq -r --arg monitor "$monitor_name" '
    map(select(.monitor == $monitor and .id >= 0))
    | sort_by(.id)
    | .[].id
' <<<"$workspaces_json")

workspace_count=${#workspace_ids[@]}
[[ "$workspace_count" -eq 0 ]] && exit 0

active_index=-1
for i in "${!workspace_ids[@]}"; do
    if [[ "${workspace_ids[$i]}" == "$active_id" ]]; then
        active_index=$i
        break
    fi
done

[[ "$active_index" -lt 0 ]] && exit 0

if [[ "$direction" == "next" ]]; then
    target_index=$(((active_index + 1) % workspace_count))
else
    target_index=$(((active_index - 1 + workspace_count) % workspace_count))
fi

hyprctl dispatch workspace "${workspace_ids[$target_index]}"
