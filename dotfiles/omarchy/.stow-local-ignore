# A package-local ignore list replaces Stow's built-in defaults, so keep the
# defaults that can apply here and add the package-specific entries below.

RCS
.+,v

CVS
\.\#.+       # CVS conflict files / emacs lock files
\.cvsignore

\.svn
_darcs
\.hg

\.git
\.gitignore
\.gitmodules

.+~          # emacs backup files
\#.*\#       # emacs autosave files

^/README.*
^/LICENSE.*
^/COPYING

# omarchy-shell rewrites shell.json with atomic writes (temp file + rename),
# which replaces a stow symlink with a regular file on the first bar gesture or
# `omarchy bar` command. Keep it tracked in git but sync it explicitly with
# scripts/shell-config.sh.
^/\.config/omarchy/shell\.json$
