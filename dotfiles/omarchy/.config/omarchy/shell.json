{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "NightLight",
            "Dictation",
            "ScreenRecording",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "mark.workspace-switcher"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "mark.bar-drawer",
          "items": [
            "io.github.kristoferlund.webcam",
            {
              "id": "mark.hardware-monitor",
              "endpoint": "http://127.0.0.1:9876"
            },
            "omarchy.bluetooth",
            "omarchy.tailscale",
            "omarchy.monitor"
          ],
          "expandOnHover": "On",
          "collapseDelay": 300,
          "chevronPosition": "left",
          "animationDuration": 300,
          "defaultExpanded": "Off"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 3600,
    "screensaver": 900,
    "away": {
      "screensaver": 300,
      "lock": 900
    }
  },
  "plugins": [
    {
      "id": "mark.appearance"
    },
    {
      "id": "io.github.kristoferlund.webcam"
    },
    {
      "id": "mark.hardware-monitor",
      "endpoint": "http://127.0.0.1:9876"
    },
    {
      "id": "mark.notifications"
    },
    {
      "id": "mark.idle"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.idle"
  ],
  "cloneSourceRestores": [
    "mark.notifications",
    "mark.idle"
  ]
}
