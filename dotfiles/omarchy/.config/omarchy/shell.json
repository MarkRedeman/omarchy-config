{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "NightLight",
            "Dictation",
            "ScreenRecording",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "mark.workspace-switcher"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "io.github.kristoferlund.webcam"
        },
        {
          "endpoint": "http://127.0.0.1:9876",
          "id": "mark.hardware-monitor"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power",
          "showPercentage": false
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "mark.notifications",
    "mark.idle"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.idle"
  ],
  "idle": {
    "away": {
      "lock": 900,
      "screensaver": 300
    },
    "lock": 3600,
    "screensaver": 900
  },
  "plugins": [
    {
      "id": "mark.appearance"
    },
    {
      "id": "mark.notifications"
    },
    {
      "id": "mark.idle"
    }
  ],
  "version": 1
}
