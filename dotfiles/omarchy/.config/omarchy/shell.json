{
  "version": 1,
  "idle": {
    "screensaver": 900,
    "lock": 960
  },
  "bar": {
    "position": "top",
    "transparent": true,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "mark.workspace-switcher"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "NightLight",
            "Dictation",
            "ScreenRecording",
            "Dnd",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "mark.hardware-monitor"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "mark.appearance"
    }
  ]
}
